# Provisioning service — environment template.
#
#   cp provisioning_service/.env.example provisioning_service/.env
#
# The real .env is gitignored. docker-compose.yml injects it into the
# provisioning-server / -worker / -beat containers via env_file; config.py
# also loads it directly for local (non-docker) runs.
#
# These vars are read from BOTH the FastAPI process and the Celery worker
# processes, so they must live in the environment (not a file inside one
# container). See docs/openstack-resources.md for the real resource IDs.

# --- OpenStack Keystone service account ---
# The client authenticates lazily and auto-refreshes the token
# (openstack/client.py), so no static token is needed here.
OPENSTACK_AUTH_URL=http://topcskeystone.cloudlab.buet.ac.bd/v3
OPENSTACK_USERNAME=
OPENSTACK_PASSWORD=
OPENSTACK_PROJECT_NAME=
OPENSTACK_USER_DOMAIN_NAME=Default
OPENSTACK_PROJECT_DOMAIN_NAME=Default

# --- OpenStack service endpoints (hardcoded for V1; catalog parsing is V2) ---
OPENSTACK_COMPUTE_URL=http://topcsnova.cloudlab.buet.ac.bd/v2.1
OPENSTACK_NETWORK_URL=http://topcsneutron.cloudlab.buet.ac.bd/v2.0
OPENSTACK_IMAGE_URL=http://topcsglance.cloudlab.buet.ac.bd/v2
OPENSTACK_VOLUME_URL=http://topcscinder.cloudlab.buet.ac.bd/v3

# Floating-IP pool used by finalize_vm_task. This is an EXTERNAL network,
# distinct from the pool's private `network_id`.
EXTERNAL_NETWORK_ID=

# --- VM creation defaults ---
VM_KEY_NAME=rdp
VM_SECURITY_GROUP=allow-ping-ssh
VM_BOOT_VOLUME_SIZE_GB=10

# --- Additional security groups / SSH key (optional; used by the legacy
#     OpenStack helpers — safe to leave blank) ---
DEFAULT_KEY_NAME=default-key
DEFAULT_SEC_GROUP_NAME=default
EXTRA_SEC_GROUP_1=
EXTRA_SEC_GROUP_2=

# --- Class-pool (teacher) compute template ---
# By default the teacher flow copies image/flavor/network from the reference
# pool TEACHER_REFERENCE_POOL ('student-pool', seeded by database/init.sql).
# Setting these decouples class pools from that pool row.
TEACHER_REFERENCE_POOL=student-pool
TEACHER_IMAGE_ID=
TEACHER_FLAVOR_ID=
TEACHER_NETWORK_ID=
TEACHER_MAX_SESSION_MINUTES=480
TEACHER_VM_COUNT_LIMIT=40

# Shown in the teacher UI only when Nova flavor metadata is unreachable.
TEACHER_FALLBACK_VCPUS=2
TEACHER_FALLBACK_RAM_MB=4096
TEACHER_FALLBACK_DISK_GB=20

# --- Database (must match database/Dockerfile) ---
DB_USER=shakshor
DB_PASSWORD=shakshor
DB_NAME=VDI
DB_HOST=database
DB_PORT=5432
DB_POOL_MIN=5
DB_POOL_MAX=20

# --- Auth service + Celery broker ---
AUTH_SERVICE_URL=http://auth-service:8003
CELERY_BROKER_URL=pyamqp://guest:guest@rabbitmq:5672//

# --- Claim queue: how long /provision/connect waits for a free VM before
#     answering 503 (the frontend then retries every 30s) ---
CLAIM_QUEUE_TIMEOUT_SECONDS=60
CLAIM_QUEUE_POLL_INTERVAL_SECONDS=2

# --- Intervals & timeouts (seconds) ---
RECONCILIATION_INTERVAL_SECONDS=30
JOB_POLL_INTERVAL_SECONDS=5
VM_CREATION_POLL_INTERVAL=10
VM_CREATION_TIMEOUT_SECONDS=300
# How long finalize waits for the guest's RDP server to accept connections
# before marking the instance ready. Fresh VMs can take several minutes.
RDP_READY_TIMEOUT_SECONDS=600
OPENSTACK_REQUEST_TIMEOUT=30

# --- Pool defaults ---
DEFAULT_MAX_SESSION_MINUTES=240
