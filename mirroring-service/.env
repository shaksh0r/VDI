# ── guacd ─────────────────────────────────────────────────────────
# Service name on guac_net Docker network — do not change to localhost
GUACD_HOST=guacd
GUACD_PORT=4822

# ── VM / RDP credentials ──────────────────────────────────────────
# VM_HOST is no longer used — floating IP resolved per-user from DB
VM_PORT=3389
VM_USERNAME=ubuntu
VM_PASSWORD=kali
VM_PROTOCOL=rdp
VM_DOMAIN=
VM_SECURITY=any

# ── Display defaults ──────────────────────────────────────────────
VM_WIDTH=1280
VM_HEIGHT=720
VM_DPI=96

# ── RDP feature flags ─────────────────────────────────────────────
VM_COLOR_DEPTH=32
VM_RESIZE_METHOD=display-update
VM_ENABLE_WALLPAPER=true
VM_ENABLE_FONT_SMOOTHING=true
VM_ENABLE_FULL_WINDOW_DRAG=true
VM_ENABLE_DESKTOP_COMP=true
VM_ENABLE_MENU_ANIMATIONS=true
VM_DISABLE_BITMAP_CACHING=false
VM_CLIENT_NAME=vdi-mirroring

# ── Auth service ──────────────────────────────────────────────────
# From inside Docker, use host.docker.internal to reach host services
AUTH_SERVICE_URL=http://auth-service:8003
# ── Database ──────────────────────────────────────────────────────
# host.docker.internal resolves to the host machine from inside Docker
DB_HOST=database
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=mydatabase