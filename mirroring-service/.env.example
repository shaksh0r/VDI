# Mirroring service — environment template.
#
#   cp mirroring-service/.env.example mirroring-service/.env
#
# The real .env is gitignored. docker-compose.yml injects it into the
# `mirroring` container via env_file. Every variable below is read by
# mirroring-service/main.py.

# --- guacd daemon ---
GUACD_HOST=guacd
GUACD_PORT=4822

# --- Service-to-service (container names inside app_net) ---
AUTH_SERVICE_URL=http://auth-service:8003
PROVISIONING_SERVICE_URL=http://provisioning-server:8001

# --- Guest RDP credentials: the DESKTOP login inside the VM image ---
# NOT the OpenStack account, and NOT the VDI web account.
# REQUIRED: if either is empty the service starts but rejects every
# /ws/guacd connection with close code 1011 ("Server misconfigured"),
# and the browser UI retries and then hangs on "Waiting…".
# Get these from whoever built the Glance image.
VM_USERNAME=ubuntu
VM_PASSWORD=ubuntu
VM_PORT=3389
VM_PROTOCOL=rdp
VM_DOMAIN=
VM_SECURITY=any

# --- Display defaults (per-connection values are clamped server-side:
#     640-7680 x 480-4320, dpi 48-288) ---
VM_WIDTH=1280
VM_HEIGHT=720
VM_DPI=96

# --- RDP feature flags ---
VM_COLOR_DEPTH=32
VM_RESIZE_METHOD=display-update
VM_ENABLE_WALLPAPER=true
VM_ENABLE_FONT_SMOOTHING=true
VM_ENABLE_FULL_WINDOW_DRAG=true
VM_ENABLE_DESKTOP_COMP=true
VM_ENABLE_MENU_ANIMATIONS=true
VM_DISABLE_BITMAP_CACHING=false
VM_CLIENT_NAME=vdi-mirroring

# --- Public (browser-reachable) URLs ---
# Empty = port-based deployment; the frontend derives http://<host>:8003 and
# :8001 from window.location. Set both when a reverse proxy terminates TLS
# and routes /auth + /provision on the same origin (served via /api/config).
AUTH_PUBLIC_URL=
PROVISION_PUBLIC_URL=

# --- Hardening / limits ---
GUACD_CONNECT_TIMEOUT=10
GUACD_HANDSHAKE_TIMEOUT=20
GUACD_READ_TIMEOUT=120
MAX_INSTRUCTION_BYTES=33554432
MAX_CONCURRENT_SESSIONS=20
MAX_SESSIONS_PER_IP=3

# Comma-separated allowlists. Empty = allow any origin (DEVELOPMENT ONLY).
# ALLOWED_ORIGINS drives CORS; WS_ALLOWED_ORIGINS is enforced on the
# WebSocket handshake. Set both to the public origin in production.
ALLOWED_ORIGINS=
WS_ALLOWED_ORIGINS=
